{
  "name": "@housepoints/mobile",
  "version": "1.0.0",
  "private": true,
  "main": "expo-router/entry",
  "expo": {
    "autolinking": {
      "searchPaths": [
        "../../node_modules",
        "./node_modules"
      ]
    }
  },
  "scripts": {
    "eas-build-post-install": "npm run build -w @housepoints/theme && npm run build -w @housepoints/contracts",
    "start": "expo start",
    "dev:mobile": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "prebuild": "expo prebuild",
    "test": "vitest run --passWithNoTests",
    "pretypecheck": "npm run build -w @housepoints/theme && npm run build -w @housepoints/contracts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint \"src/**/*.{ts,tsx}\""
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@housepoints/contracts": "*",
    "@housepoints/theme": "*",
    "@react-native-community/netinfo": "11.5.2",
    "@tanstack/react-query": "^5.60.0",
    "expo": "~55.0.31",
    "expo-constants": "~55.0.17",
    "expo-device": "~55.0.21",
    "expo-font": "~55.0.8",
    "expo-linking": "~55.0.17",
    "expo-notifications": "~55.0.27",
    "expo-router": "~55.0.18",
    "expo-secure-store": "~55.0.18",
    "expo-splash-screen": "~55.0.25",
    "expo-status-bar": "~55.0.6",
    "expo-system-ui": "~55.0.22",
    "expo-updates": "~55.0.30",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-native": "0.83.10",
    "react-native-auth0": "^5.11.0",
    "react-native-gesture-handler": "~2.30.0",
    "react-native-keyboard-controller": "1.20.7",
    "react-native-reanimated": "4.2.1",
    "react-native-safe-area-context": "~5.6.2",
    "react-native-screens": "~4.23.0",
    "react-native-worklets": "0.7.4",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@babel/core": "^7.26.0",
    "@types/react": "~19.2.10",
    "eslint": "^9",
    "typescript": "~5.9.2",
    "vitest": "^5.0.2"
  }
}

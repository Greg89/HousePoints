{
  "name": "@housepoints/mobile",
  "version": "1.0.0",
  "private": true,
  "main": "expo-router/entry",
  "expo": {
    "autolinking": {
      "searchPaths": [
        "../../node_modules",
        "./node_modules"
      ]
    },
    "install": {
      "exclude": [
        "typescript"
      ]
    }
  },
  "scripts": {
    "eas-build-post-install": "npm run build -w @housepoints/theme && npm run build -w @housepoints/contracts",
    "start": "expo start",
    "dev:mobile": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "prebuild": "expo prebuild",
    "test": "vitest run --passWithNoTests",
    "pretypecheck": "npm run build -w @housepoints/theme && npm run build -w @housepoints/contracts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint \"src/**/*.{ts,tsx}\""
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@housepoints/contracts": "*",
    "@housepoints/theme": "*",
    "@react-native-community/netinfo": "12.0.1",
    "@tanstack/react-query": "^5.104.5",
    "expo": "~57.0.30",
    "expo-constants": "~57.0.22",
    "expo-device": "~57.0.2",
    "expo-font": "~57.0.4",
    "expo-haptics": "~57.0.3",
    "expo-linking": "~57.0.13",
    "expo-notifications": "~57.0.23",
    "expo-router": "~57.0.28",
    "expo-secure-store": "~57.0.4",
    "expo-splash-screen": "~57.0.10",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "expo-updates": "~57.0.26",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-native": "0.88.0",
    "react-native-auth0": "^5.11.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-keyboard-controller": "1.22.8",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-worklets": "0.13.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@types/react": "~19.3.0",
    "eslint": "^9",
    "typescript": "~5.9.2",
    "vitest": "^5.0.5"
  }
}

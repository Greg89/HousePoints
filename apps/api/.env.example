DATABASE_URL="postgresql://postgres:postgres@localhost:5432/housepoints"
DATABASE_POOL_MAX="5"
PORT="4000"
API_PORT="4000"
LOG_LEVEL="info"
SERVICE_NAME="housepoints-api"
AUTH0_DOMAIN="your-tenant.us.auth0.com"
AUTH0_CLIENT_ID="your-web-client-id"
AUTH0_AUDIENCE="https://api.housepoints.example"
CORS_ALLOWED_ORIGINS="http://localhost:3000"
POINT_ADJUSTMENTS_ENABLED="false"
PUBLIC_ORGANIZATION_CREATION_ENABLED="true"
MAX_ACTIVE_ORGANIZATIONS="10"
PLATFORM_OWNER_AUTH0_SUBS="auth0|replace-with-platform-owner-subject"
PUSH_DISPATCH_ENABLED="false"
EXPO_ACCESS_TOKEN=""
SEQ_SERVER_URL=""
SEQ_API_KEY=""
DEFAULT_ORGANIZATION_SLUG="default"
DEFAULT_ORGANIZATION_NAME="Default Org"
